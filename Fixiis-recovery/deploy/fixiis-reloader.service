[Unit]
Description=Fixiis auto-restart watcher (restarts the app when backend files change)
Documentation=https://github.com/freemancatalogue979-web/v2
After=network-online.target fixiis.service
Wants=fixiis.service

[Service]
# Deliberately simple: the watcher only needs to read the install directory
# and talk to systemd over D-Bus, so it runs as root while the app itself
# keeps running as the unprivileged fixiis user.
Type=simple
User=root
Group=root
WorkingDirectory=/opt/fixiis
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fixiis/venv/bin/python /opt/fixiis/deploy/autoreload.py \
    --dir /opt/fixiis \
    --unit fixiis \
    --interval 2 \
    --debounce 3 \
    --min-interval 10 \
    --health-url http://127.0.0.1:8446/health \
    --health-timeout 90
# deploy/setup.sh rewrites the port above from PORT in .env. Drop the
# --health-url line entirely if you would rather not probe after a restart.

# The watcher must survive anything; the app restart is handled by systemd.
Restart=always
RestartSec=3

# It writes nothing and needs no network of its own beyond the health probe,
# so it gets its own private /tmp.
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fixiis-reloader

[Install]
WantedBy=multi-user.target
